# --- Agente HTTP
PORT=3000
LOG_DIR=daemon
LOG_MAX_BYTES=5242880

# Motor de streaming: "ffmpeg" (recomendado) o "butt" (legacy)
STREAM_ENGINE=ffmpeg

# --- ffmpeg (solo con STREAM_ENGINE=ffmpeg)
FFMPEG_PATH=ffmpeg
# Donde el panel guarda dispositivo, códec, bitrate, canales y ganancia.
# Las rutas relativas se resuelven contra la carpeta del agente.
STREAM_SETTINGS_FILE=stream-settings.json

# Lo que se guarda desde el panel (motor, servidor, rutas, backend) se escribe
# acá y tiene prioridad sobre este .env. Contiene secretos: no lo commitees.
AGENT_CONFIG_FILE=agent-config.json

# --- AzuraCast: credenciales de la fuente. Nunca viajan al panel.
# Salen de AzuraCast → Emisora → Streams / "Source connection".
AZURACAST_HOST=radio.example.com
AZURACAST_PORT=8000
# Puede ser "/" (harbor de Liquidsoap) o "/stream", "/radio", etc.
AZURACAST_MOUNT=/stream
AZURACAST_SOURCE_USER=source
AZURACAST_SOURCE_PASSWORD=cambiame

# TLS para la conexión de fuente (cuando el harbor está detrás de HTTPS)
AZURACAST_TLS=false

# Origen público que sirve la API now-playing de AzuraCast, usado para verificar
# que la emisora realmente está emitiendo el audio ("al aire") y no el AutoDJ.
# Si se omite, se usa BACKEND_URL, que expone la misma API.
AZURACAST_PUBLIC_URL=

# Datos que se anuncian al servidor de streaming (opcionales)
AZURACAST_STREAM_NAME=
AZURACAST_GENRE=
AZURACAST_WEBSITE=
AZURACAST_IS_PUBLIC=false

# --- butt (solo con STREAM_ENGINE=butt)
BUTT_EXE_PATH=C:/Program Files/butt/butt.exe
BUTT_CONFIG_PATH=
BUTT_LAUNCH_TIMEOUT_MS=8000
BUTT_COMMAND_TIMEOUT_MS=10000

# --- Backend (metadatos y webhooks)
BACKEND_URL=https://lavozverdad.com
BACKEND_SECRET=cambiame
BUTT_HTTP_TIMEOUT_MS=5000
